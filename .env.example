
# ========================================
# DATABASE CONFIGURATION
# ========================================

DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5432/helpdesk_db?schema=public"

# ========================================
# JWT CONFIGURATION
# ========================================

JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="1h"

# ========================================
# OPTIONAL TEST ACCOUNTS
# Set these to match existing test users
# ========================================

TEST_USER_EMAIL="user@example.com"
TEST_USER_PASSWORD="REPLACE_WITH_TEST_USER_PASSWORD"

TEST_ADMIN_EMAIL="admin@example.com"
TEST_ADMIN_PASSWORD="REPLACE_WITH_TEST_ADMIN_PASSWORD"
